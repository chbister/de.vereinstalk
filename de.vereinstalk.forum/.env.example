# Vorlage für die lokale Konfiguration.
# Kopieren mit: cp .env.example .env
# Die .env wird NICHT committet (siehe .gitignore), diese Datei schon.

# Öffentlicher Port des Forums auf dem Host
FORUM_PORT=8081

# Öffentliche URL des Forums (wird als baseUrl in config.php geschrieben).
# WICHTIG: muss exakt der URL entsprechen, über die das Forum aufgerufen wird,
# sonst leitet Flarum um. Beispiele:
#   FLARUM_URL=http://localhost:8081
#   FLARUM_URL=https://forum.devereinstalkforum.orb.local
# Nachträglich ändern: Wert anpassen, Container neu starten (config.php wird
# beim Start automatisch synchronisiert, solange die DB erhalten bleibt).
FLARUM_URL=http://localhost:8081

# Datenbank-Zugangsdaten
MARIADB_ROOT_PASSWORD=hier-sicheres-root-passwort-eintragen
MARIADB_DATABASE=flarum
MARIADB_USER=flarum
MARIADB_PASSWORD=hier-sicheres-passwort-eintragen

# Unbeaufsichtigte Installation beim ersten Containerstart
# (entspricht dem Web-Formular "Install Flarum", nutzt `php flarum install -f`).
# true = automatisch installieren, false = Web-Installer im Browser nutzen.
FLARUM_AUTO_INSTALL=true
FLARUM_TITLE=Vereinstalk
FLARUM_DEBUG=false

# Admin-Zugang (Pflicht bei FLARUM_AUTO_INSTALL=true, Passwort mind. 8 Zeichen)
FLARUM_ADMIN_USER=admin
FLARUM_ADMIN_EMAIL=admin@example.com
FLARUM_ADMIN_PASSWORD=hier-sicheres-admin-passwort-eintragen-mind-8-zeichen

# Datenbank-Anbindung des Forums (Standard passt zu Service `mariadb` unten)
FLARUM_DB_HOST=mariadb
FLARUM_DB_PORT=3306
# Tabellen-Präfix, entspricht Feld "Table Prefix" im Web-Installer (meist leer)
FLARUM_DB_PREFIX=

# Farbgebung (Admin-Panel -> Erscheinungsbild -> Farbgebung).
# Erste Farbe = Akzente, zweite = Hintergrundelemente. Format #rgb oder #rrggbb.
# Gesetzte Werte werden bei jedem Start enforced (überschreiben manuelle
# Änderungen); leer lassen = Admin-Panel-Einstellung bleibt unangetastet.
FLARUM_THEME_PRIMARY=#ea580c
FLARUM_THEME_SECONDARY=#ffedd5

# Willkommensnachricht (Admin-Panel -> Grundeinstellungen).
# Gleiche Semantik wie Farben: gesetzt = enforced, leer = Panel-Einstellung bleibt.
# \n im Text wird zum Zeilenumbruch.
FLARUM_WELCOME_TITLE=Willkommen bei Vereinstalk
FLARUM_WELCOME_MESSAGE=Schön, dass du da bist! Starte eine Diskussion oder stöbere durch die bestehenden Themen.

# Forumbeschreibung (Grundeinstellungen; erscheint in Meta-Tags/Suchmaschinen).
# Gleiche Semantik: gesetzt = enforced, leer = Panel-Einstellung bleibt.
FLARUM_DESCRIPTION=Das Vereinsforum zum Austauschen, Fragen und Mitmachen.

# Standardsprache (Grundeinstellungen) und Extensions, die NUR bei einer
# Neuinstallation automatisch aktiviert werden (der Installer aktiviert sonst
# nur Core-Bundled-Extensions). Späteres manuelles Deaktivieren im Admin-Panel
# hat Bestand — der Block läuft ausschließlich nach Fresh-Install.
FLARUM_DEFAULT_LOCALE=de
FLARUM_ENABLE_EXTENSIONS=flarum-lang-german,flarum-lang-french,flarum-lang-english
