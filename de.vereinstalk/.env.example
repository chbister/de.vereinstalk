# Lokale Konfiguration für die statische Marketingseite (vereinstalk.de)
# Kopieren mit: cp .env.example .env
# Die .env wird NICHT committet (siehe Root-.gitignore), diese Datei schon.

# Öffentlicher Port der statischen Seite auf dem Host (nur DEV relevant;
# in PROD routet Traefik über das Docker-Netzwerk, kein Port-Publishing nötig)
SITE_PORT=8080

# Name des externen Docker-Netzwerks (z. B. für Reverse-Proxy)
# DEV: dev-shared-network, PROD: z. B. prod-edge / traefik-net (muss auf dem
# Server per `docker network create` existieren und zu Traefik passen)
EDGE_NETWORK_NAME=dev-shared-network

# --- Nur PROD (docker-compose.prod.yml) ---
# Öffentliche Domain für die Traefik-Rule `Host(...)`
SITE_DOMAIN=vereinstalk.de
# Traefik-Entrypoint und Cert-Resolver (müssen zu deiner Traefik-Config passen)
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Image-Referenz (Default: GHCR :latest; CI/Deploy pinnt per SITE_IMAGE den SHA)
SITE_IMAGE=ghcr.io/chbister/vereinstalk-site:latest
